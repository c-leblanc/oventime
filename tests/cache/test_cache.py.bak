import sqlite3
import time
import json
import pandas as pd
import pytest

from oventime.cache import cache
from pathlib import Path

def make_output(now):
    return {
        "time": now,
        "status": "ok",
        "score": 42.5,
        "nuclear_bonus": 0.0,
        "ocgt_malus": 0.0,
        "gasCCG_use_rate": 0.1,
        "gasCCG_phase": 0.1,
        "storage_phase": 0.2,
        "storage_use_rate": 0.2,
        "nuclear_use_rate": 0.5,
        "nextwind_start": now,
        "nextwind_end": now + pd.Timedelta(minutes=15),
        "nextwind_method": "otsu"
    }

def test_save_and_get_fulldiag(tmp_path):
    # point cache DB to tmp file
    db_path = tmp_path / "cache.sqlite"
    cache_mod.DB_PATH = db_path

    # init DB
    cache_mod.init_db()

    now = pd.Timestamp.now(tz="UTC").floor("15min")
    out = make_output(now)
    cache_mod.save(out, source_version="testv")

    fulldiag = cache_mod.get_fulldiag()
    assert fulldiag is not None
    assert fulldiag["status"] == "ok"
    assert "details" in fulldiag
    assert fulldiag["details"]["gasCCG_use_rate"] == pytest.approx(0.1)

def test_get_status_and_nextwindow(tmp_path):
    db_path = tmp_path / "cache.sqlite"
    cache_mod.DB_PATH = db_path
    cache_mod.init_db()

    now = pd.Timestamp.now(tz="UTC").floor("15min")
    out = make_output(now)
    cache_mod.save(out)

    status = cache_mod.get_status()
    assert status is not None
    assert status["status"] == "ok"

    nextw = cache_mod.get_nextwindow()
    assert nextw is not None
    assert "nextwind_start" in nextw
    assert "nextwind_end" in nextw

def test_tsubs_add_remove(tmp_path):
    db_path = tmp_path / "cache.sqlite"
    cache_mod.DB_PATH = db_path
    cache_mod.init_db()

    cache_mod.add_tsubs(123456)
    subs = cache_mod.get_tsubs()
    assert 123456 in subs

    cache_mod.remove_tsubs(123456)
    subs2 = cache_mod.get_tsubs()
    assert 123456 not in subs2

def test_wsubs_add_remove(tmp_path):
    db_path = tmp_path / "cache.sqlite"
    cache_mod.DB_PATH = db_path
    cache_mod.init_db()

    ep = "https://example.com/endpoint"
    sub = {"endpoint": ep, "keys": {"p256dh": "aaa", "auth": "bbb"}}
    cache_mod.add_wsubs(ep, sub)

    wsubs = cache_mod.get_wsubs()
    assert ep in wsubs
    assert wsubs[ep]["keys"]["auth"] == "bbb"

    cache_mod.remove_wsubs(ep)
    wsubs2 = cache_mod.get_wsubs()
    assert ep not in wsubs2
